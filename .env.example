# 将本文件复制为 .env 后，再在等号后填写自己的信息。
# 不要把 .env 提交到 Git，也不要在聊天中发送 API Key。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v2
CHAT_MODEL=qwen-plus

# qwen3-rerank 使用独立的百炼兼容地址，但复用同一 DASHSCOPE_API_KEY。
DASHSCOPE_RERANK_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank

# 公开 Demo 开启后，只读并固定使用指定的云端知识库。
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_KNOWLEDGE_BASE_NAME=公开演示知识库
MAX_UPLOAD_BYTES=2097152
MAX_CHUNK_COUNT=200
MAX_QUESTION_LENGTH=1000
EMBEDDING_BATCH_SIZE=32

# 可选：配置后启用 Supabase 云端持久化与多知识库。
# 仅填写服务端环境变量，绝不把 SECRET_KEY 放进前端代码。
SUPABASE_URL=
SUPABASE_SECRET_KEY=
